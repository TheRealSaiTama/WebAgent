# ==============================================================================
# PROJECT-SPECIFIC: RESEARCH OUTPUTS
# ==============================================================================

# Research output files (generated, should not be committed)
research.json
research.txt
research.md
research.html

# Timestamped run outputs
runs/
output/
reports/
results/

# ==============================================================================
# PROJECT-SPECIFIC: CACHE
# ==============================================================================

# Application cache directory
.cache/
cache/

# Serper API cache
.cache/web-research-agent/
*.cache.json

# ==============================================================================
# PROJECT-SPECIFIC: CONFIGURATION & SECRETS
# ==============================================================================

# Environment files (may contain secrets)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# Config files with secrets
config.json
config.local.json
config.*.json
!config.example.json
!config.template.json

# API keys and credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
credentials.json
secrets.json
api_keys.json
.secrets/
secrets/

# ==============================================================================
# PROJECT-SPECIFIC: LOGS
# ==============================================================================

# Log files
*.log
logs/
log/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==============================================================================
# PROJECT-SPECIFIC: TEMPORARY FILES
# ==============================================================================

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old

# ==============================================================================
# DOCUMENTATION BUILD
# ==============================================================================

# Sphinx
docs/_build/
doc/_build/

# MkDocs
site/

# ==============================================================================
# DOCKER
# ==============================================================================

# Docker
.docker/
docker-compose.override.yml
docker-compose.local.yml

# ==============================================================================
# MISCELLANEOUS
# ==============================================================================

# Backup files
*.bak
*.backup
*.orig

# Archive files (usually shouldn't be in repo)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Large data files
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
!example*.csv
!test*.csv
!sample*.csv

# Database files
*.db
*.sqlite
*.sqlite3

# Profiling data
*.prof
*.lprof
*.cprof

# Coverage data
.coverage
htmlcov/

# Benchmarks
.benchmarks/

# Node (if any frontend)
node_modules/
.npm/
.yarn/

# ==============================================================================
# ALLOW PATTERNS (Negation)
# ==============================================================================

# Keep input template
!input.txt

# Keep example configurations
!*.example
!*.template
!*.sample

# Keep requirements
!requirements.txt
!requirements-dev.txt
!requirements-test.txt

# Keep essential config
!pyproject.toml
!setup.py
!setup.cfg
!MANIFEST.in

# ==============================================================================
# END OF .gitignore
# ==============================================================================
